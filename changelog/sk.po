#: Changelog.yaml:0
msgid "Edit book: Fix a memory leak in the HTML syntax highlighter"
msgstr "Upraviť knihu: Oprava úniku pamäte v zvýrazňovači syntaxe HTML"

#: Changelog.yaml:0
msgid "calibredb list: Fix identifier values not being shown"
msgstr "calibredb list: Oprava nezobrazovania hodnôt identifikátorov"

#: Changelog.yaml:0
msgid "07 Nov, 2025"
msgstr "7. novembra 2025"

#: Changelog.yaml:0
msgid "Tolino driver: Add support for latest firmware"
msgstr "Ovládač Tolino: Pridanie podpory pre najnovší firmvér"

#: Changelog.yaml:0
msgid ""
"When showing completions for languages show all languages that contain the "
