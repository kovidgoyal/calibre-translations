#: Changelog.yaml:0
msgid "Get books: Fix ebooks.com plugin"
msgstr "Získať knihy: Oprava zásuvného modulu ebooks.com"

#: Changelog.yaml:0
msgid "calibre-server: Fix CALIBRE_OVERRIDE_DATABASE_PATH not working"
msgstr ""
"calibre-server: Oprava nefunkčnej premennej CALIBRE_OVERRIDE_DATABASE_PATH"

#: Changelog.yaml:0
msgid ""
"Export library: Don't use /tmp on Linux fixes export breaking with large FTS"
