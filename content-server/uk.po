msgstr "Змініть розмір полів (у пікселях) нижче"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:54
msgid "Top:"
msgstr "Верхнє:"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:54
msgid "Bottom:"
msgstr "Нижнє:"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:54
msgid "Left:"
msgstr "Ліве:"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:54
msgid "Right:"
msgstr "Праве:"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:70
msgid ""
"Choose the page layout mode. In paged mode, the text is split up into "
"individual pages, as in a paper book. In flow mode text is presented as one "
"long scrolling page, as in web browsers."
msgstr "Виберіть режим компонування сторінки. У режимі поділу на сторінки текст буде поділено між окремими сторінками, як у звичайній паперовій книзі. У режимі неперервного перегляду текст буде розташовано на одній сторінці із можливістю гортання, як у програмах для перегляду сторінок інтернету."

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:79
msgid "Paged mode"
msgstr "Режим поділу на сторінки"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:81
msgid "Flow mode"
msgstr "Неперервний режим"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:83
msgid ""
"In paged mode, control the number of pages per screen. A setting of zero "
"means the number of pages is set based on the screen size."
msgstr "У режимі поділу на сторінки можна визначити кількість сторінок, які буде показано на екрані. Нульове значення означає, що кількість сторінок буде визначено на основі розмірів екрана."

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:88
msgid "Portrait:"
msgstr "Книжкова:"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:89
msgid "Landscape:"
msgstr "Альбомна:"

#: /__w/calibre/calibre/src/pyj/read_book/prefs/layout.pyj:92
msgid ""
"Change the maximum screen area (in pixels) used to display text. A value of "
"zero means that all available screen area is used."
