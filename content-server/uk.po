#: /__w/calibre/calibre/src/pyj/book_list/fts.pyj:206
#, python-brace-format
msgid ""
"\n"
"<div class=\"h\">Search for single words</div>\n"
"<p>Simply type the word:</p>\n"
"<div class=\"bq\">awesome<br>calibre</div>\n"
"\n"
"<div class=\"h\">Search for phrases</div>\n"
"<p>Enclose the phrase in quotes:</p>\n"
"<div class=\"bq\">\"early run\"<br>\"song of love\"</div>\n"
"\n"
"<div class=\"h\">Boolean searches</div>\n"
"<div class=\"bq\">(calibre AND ebook) NOT gun<br>simple NOT (\"high bar\" OR hard)</div>\n"
"\n"
"<div class=\"h\">Phrases near each other</div>\n"
"<div class=\"bq\">NEAR(\"people\" \"in Asia\" \"try\")<br>NEAR(\"Kovid\" \"calibre\", 30)</div>\n"
"<p>Here, 30 is the most words allowed between near groups. Defaults to 10 when unspecified.</p>\n"
"\n"
"<div style=\"margin-top: 1em\"><a href=\"{fts_url}\">Complete syntax reference</a></div>"
msgstr "\n<div class=\"h\">Пошук окремих слів</div>\n<p>Просто введіть слово:</p>\n<div class=\"bq\">чудова<br>calibre</div>\n\n<div class=\"h\">Пошук фраз</div>\n<p>Візьміть фразу у лапки:</p>\n<div class=\"bq\">\"ранній забіг\"<br>\"пісня кохання\"</div>\n\n<div class=\"h\">Булеві пошуки</div>\n<div class=\"bq\">(calibre AND ebook) NOT зброя<br>просто NOT (\"високий бар'єр\" OR важко)</div>\n\n<div class=\"h\">Фрази поруч одна з одною</div>\n<div class=\"bq\">NEAR(\"люди\" \"в Азії\" \"намагаються\")<br>NEAR(\"Kovid\" \"calibre\", 30)</div>\n<p>Тут 30 найбільша кількість слів між сусідніми групами. Типовим значенням, якщо не вказано іншого, є 10.</p>\n\n<div style=\"margin-top: 1em\"><a href=\"{fts_url}\">Довідник щодо синтаксису</a></div>"

